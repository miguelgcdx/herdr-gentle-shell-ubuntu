+test('native80 metadata keeps full-path ownership and original first-harness logo rules', async t => {
+  const fullPath = '/mock/' + 'long-session-'.repeat(9) + 'é-parent.jsonl';
+  const otherPath = fullPath.replace('parent', 'foreign');
+  assert.ok([...fullPath].length > 80);
+  assert.equal(fullPath.slice(0, 80), otherPath.slice(0, 80));
+  const native = tokens => Object.fromEntries(Object.entries(tokens).map(([k, v]) => [k, [...v].slice(0, 80).join('')]));
+  const tokens = native({ subagents_running: '2', subagents_session_key: owner(fullPath), subagents_roles: 'A+R+W+V+RD' });
+  assert.equal(tokens.subagents_session_key.length, 64);
+  assert.equal(tokens.subagents_roles.length, 10);
+  const first = agent('A', { agent_session: { kind: 'path', value: fullPath }, tokens });
+  const second = { ...first, pane_id: 'w1:p2', tab_id: 'w1:t2' };
+  const f = fixture(t, [first, second]);
+  assert.ok((await state.snapshot()).every(e => e.subagentsRoles === 'A+R+W+V+RD'));
+  await f.render();
+  assert.equal(f.written().logo, logoFor('pi'));
+  assert.equal(f.written('w1:p2').logo, null);
+  assert.equal(f.written('w1:p2').harness_logo, logoFor('pi'));
+  assert.ok(f.written('w1:p2').title_delegating.endsWith('A+R+W+V+RD Inspect  project · π - unchanged'));
+  f.set([{ ...first, agent_session: { kind: 'path', value: otherPath } }]);
+  assert.equal((await state.snapshot())[0].subagentsRoles, '');
+  await f.render();
+  assert.equal(f.written().title_delegating, null);
+  assert.equal(f.written().title_idle, plainTitle);
+  assert.equal(f.written('w1:p2').title_delegating, null, 'closed pane clears role title');
+});
