+test('every Pi row removes its textual marker, including the first logo owner and working spinner', async t => {
+  const original = agent('', { tokens: {} });
+  const second = { ...original, pane_id: 'w1:p2', tab_id: 'w1:t2' };
+  const f = fixture(t, [original, second]);
+  for (const status of ['idle', 'working', 'blocked', 'done', 'unknown']) {
+    // Register mocks once. Only recreate the public Frame to isolate cases
+    // from working/blocked holds; do not stack mocks on the same properties.
+    f.reset([{ ...original, agent_status: status }, { ...second, agent_status: status }]);
+    await f.render();
+    for (const pane of ['w1:p1', 'w1:p2']) {
+      const tokens = f.written(pane);
+      const displayed = Object.entries(tokens).filter(([key, value]) => key.startsWith('title_') && value);
+      assert.equal(displayed.length, 1, `${status} ${pane}`);
+      assert.ok(displayed[0][1].endsWith(plainTitle), `${status} ${pane}`);
+      assert.ok(!displayed[0][1].includes('π - Inspect'), 'leading marker is absent');
+      assert.ok(tokens[`state_${status}`], 'lifecycle mark is preserved');
+      assert.equal(tokens.harness_logo, logoFor('pi'));
+      assert.equal(original.terminal_title_stripped, title, 'native title is unchanged');
+      if (status === 'working') assert.ok(config.FRAMES.some(frame => displayed[0][1].includes(frame)), 'spinner is preserved');
+      if (status === 'done') assert.ok(displayed[0][1].includes(stateGlyph('done')), 'visible finished check is preserved');
+      if (status === 'blocked') assert.ok([stateGlyph('blocked'), stateGlyph('idle')].some(mark => displayed[0][1].includes(mark)), 'visible blocked pulse is preserved');
+    }
+    const first = f.written();
+    assert.ok(['logo', 'logo_working', 'logo_stale'].some(key => first[key]?.endsWith(logoFor('pi'))));
+    for (const key of ['logo', 'logo_working', 'logo_stale']) assert.equal(f.written('w1:p2')[key], null);
+  }
+});
