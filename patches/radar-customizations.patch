+++ b/test/workspace-logo.test.js
@@ -0,0 +1,137 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+
+const scratch = fs.mkdtempSync(path.join(os.tmpdir(), 'radar-workspace-logo-'));
+const configDir = path.join(scratch, 'config');
+fs.mkdirSync(configDir);
+fs.writeFileSync(
+  path.join(configDir, 'config.toml'),
+  'variant = "font"\nfollow_appearance = false\ngroup_gap = false\nlogo_scope = "first_per_workspace"\n',
+);
+process.env.HERDR_PLUGIN_CONFIG_DIR = configDir;
+process.env.HERDR_RADAR_STATE = path.join(scratch, 'state');
+test.after(() => fs.rmSync(scratch, { recursive: true, force: true }));
+
+const activity = require('../lib/activity');
+const config = require('../lib/config');
+const herdr = require('../lib/herdr');
+const hook = require('../lib/hook');
+const state = require('../lib/state');
+const view = require('../lib/view');
+const { logoFor } = require('../lib/logos');
+const { Frame } = require('../lib/frame');
+
+function entry(workspace, number, name = 'pi') {
+  return {
+    pane: `${workspace}:p${number}`,
+    terminal: `${workspace}:terminal${number}`,
+    workspace,
+    tab: `${workspace}:t${number}`,
+    name,
+    title: `Session ${number}`,
+    status: 'idle',
+  };
+}
+
+// Observe the public metadata writes; never contact a running Herdr server.
+function fixture(t, entries, stamps, mode = 'grouped') {
+  const published = new Map();
+  let writes = 0;
+  t.mock.method(activity, 'load', () => new Map());
+  t.mock.method(activity, 'save', () => {});
+  t.mock.method(state, 'snapshot', async () => entries);
+  t.mock.method(state, 'labels', async () => ({
+    tabs: new Map(),
+    workspaces: new Map(entries.map((item) => [item.workspace, item.workspace])),
+    parents: new Map(),
+    worktrees: new Map(),
+  }));
+  t.mock.method(view, 'mode', () => mode);
+  t.mock.method(hook, 'apply', (kind, value, pane) => (kind === 'activity' ? stamps.get(pane) : value));
+  t.mock.method(herdr, 'reportMetadataAsync', async (pane, _source, tokens) => {
+    writes += 1;
+    published.set(pane, { ...published.get(pane), ...tokens });
+    return true;
+  });
+  t.mock.method(herdr, 'reportMetadata', () => true);
+  const frame = new Frame('test');
+  t.mock.method(frame.workspaceOrder, 'sync', async () => {});
+  t.mock.method(frame, 'displayFor', (item) => item.status);
+  t.mock.method(frame, 'spaceJobs', () => {});
+  t.mock.method(frame, 'groupJobs', async () => {});
+  return { frame, published, writes: () => writes };
+}
+
+function visibleLogo(tokens) {
+  return Object.entries(tokens).find(([key, value]) => /^logo(?:_|$)/.test(key) && value)?.[1] ?? null;
+}
+
+function assertOwners(published, entries, owners) {
+  assert.deepEqual(
+    [...published].filter(([, tokens]) => visibleLogo(tokens)).map(([pane]) => pane).sort(),
+    [...owners].sort(),
+  );
+  for (const item of entries) {
+    const tokens = published.get(item.pane);
+    assert.equal(tokens.harness_logo, logoFor(item.name), 'canonical harness identity must remain on every pane');
+    assert.ok(tokens.title_idle.endsWith(item.title), 'hiding a logo must not hide or replace its title');
+    assert.ok(tokens.state_idle, 'lifecycle state must remain available');
+    if (owners.includes(item.pane)) assert.equal(visibleLogo(tokens).replace(/^[\u200b\s]+/u, ''), logoFor(item.name));
+    else assert.equal(visibleLogo(tokens), null);
+  }
+}
+
+test('ten Pi sessions show one logo at the first displayed entry in each project', async (t) => {
+  const entries = [
+    ...Array.from({ length: 10 }, (_, i) => entry('project-a', i + 1)),
+    ...Array.from({ length: 3 }, (_, i) => entry('project-b', i + 1)),
+  ];
+  const stamps = new Map(entries.map((item, i) => [item.pane, (i + 1) * 60000]));
+  const { frame, published } = fixture(t, entries, stamps);
+  await frame.render(1000000);
+  assertOwners(published, entries, ['project-a:p10', 'project-b:p3']);
+});
+
+test('different harnesses each retain their first logo within the same project', async (t) => {
+  const entries = [entry('project-a', 1), entry('project-a', 2), entry('project-a', 3, 'claude'), entry('project-a', 4, 'claude')];
+  const stamps = new Map(entries.map((item, i) => [item.pane, (i + 1) * 60000]));
+  const { frame, published } = fixture(t, entries, stamps);
+  await frame.render(1000000);
+  assertOwners(published, entries, ['project-a:p2', 'project-a:p4']);
+});
+
+test('a reordered group transfers its logo and clears the cached old owner', async (t) => {
+  const entries = [entry('project-a', 1), entry('project-a', 2)];
+  const stamps = new Map([['project-a:p1', 120000], ['project-a:p2', 60000]]);
+  const { frame, published, writes } = fixture(t, entries, stamps);
+  await frame.render(1000000);
+  assertOwners(published, entries, ['project-a:p1']);
+  stamps.set('project-a:p2', 180000);
+  await frame.render(1000150);
+  assertOwners(published, entries, ['project-a:p2']);
+  const acceptedWrites = writes();
+  await frame.render(1000300);
+  assert.equal(writes(), acceptedWrites, 'unchanged idle rows must not gain redundant metadata writes');
+});
+
+test('all scope retains the existing logo on every session', async (t) => {
+  const previous = config.logoScope;
+  config.logoScope = 'all';
+  t.after(() => { config.logoScope = previous; });
+  const entries = [entry('project-a', 1), entry('project-a', 2)];
+  const { frame, published } = fixture(t, entries, new Map());
+  await frame.render(1000000);
+  assertOwners(published, entries, entries.map((item) => item.pane));
+});
+
+test('flat recent view retains the existing per-session logos', async (t) => {
+  const entries = [entry('project-a', 1), entry('project-a', 2)];
+  const { frame, published } = fixture(t, entries, new Map(), 'recent');
+  await frame.render(1000000);
+  assertOwners(published, entries, entries.map((item) => item.pane));
