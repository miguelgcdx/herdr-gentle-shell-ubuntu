+    await f.render();
+    assert.equal(f.written().title_delegating, null);
+    const shown = f.written()[`title_${status}`];
+    assert.ok(shown.endsWith(plainTitle) && !shown.includes('π - Inspect'));
+    assert.ok(f.written()[`state_${status}`]);
+  });
+}
