+// Display-only Pi activity belongs to this exact SDK session file. Never
+// coerce arbitrary metadata into a count or let another harness inherit it.
+function subagentsRunning(agent, tokens) {
+  const count = tokens.subagents_running;
+  const owner = tokens.subagents_session_key;
+  const session = agent.agent_session?.value;
+  if (
+    agent.agent !== 'pi' ||
+    agent.agent_session?.kind !== 'path' ||
+    typeof session !== 'string' || !session ||
+    typeof owner !== 'string' || owner.length !== 64 || !/^[0-9a-f]+$/.test(owner) ||
+    typeof count !== 'string' || !/^[0-9]+$/.test(count)
+  ) return 0;
+  // Native metadata values stop at 80 characters; hash the complete native
+  // session value rather than accepting a truncated path or shared prefix.
+  if (owner !== createHash('sha256').update(session, 'utf8').digest('hex')) return 0;
+  const value = Number(count);
+  return Number.isSafeInteger(value) && value > 0 ? value : 0;
+}
+
+const SUBAGENT_ROLE_CODES = ['A', 'R', 'W', 'V', 'RD'];
+
+// Read roles only after exact session ownership and count validation. Reject
+// the whole token on any unknown code rather than mislabel a mixed group.
+function subagentRoles(tokens, running) {
+  if (!running) return '';
+  const roles = tokens.subagents_roles;
+  if (typeof roles !== 'string' || !roles || roles.length > 11) return '';
+  const codes = roles.split('+');
+  if (!codes.every(code => SUBAGENT_ROLE_CODES.includes(code))) return '';
+  return SUBAGENT_ROLE_CODES.filter(code => codes.includes(code)).join('+');
+}
